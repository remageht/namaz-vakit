<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget2_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🕌 Намаз"
        android:textColor="#D4AF37"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:layout_marginBottom="2dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w2_name_1" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Фаджр" android:textColor="#86EFAC"
            android:textSize="11sp" android:maxLines="1" android:singleLine="true" />
        <TextView android:id="@+id/w2_time_1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textAlignment="viewEnd" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w2_name_2" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Зухр" android:textColor="#86EFAC"
            android:textSize="11sp" android:maxLines="1" android:singleLine="true" />
        <TextView android:id="@+id/w2_time_2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textAlignment="viewEnd" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w2_name_3" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Аср" android:textColor="#86EFAC"
            android:textSize="11sp" android:maxLines="1" android:singleLine="true" />
        <TextView android:id="@+id/w2_time_3" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textAlignment="viewEnd" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w2_name_4" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Магриб" android:textColor="#86EFAC"
            android:textSize="11sp" android:maxLines="1" android:singleLine="true" />
        <TextView android:id="@+id/w2_time_4" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textAlignment="viewEnd" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/w2_name_5" android:layout_width="0dp" android:layout_weight="1.4"
            android:layout_height="wrap_content" android:text="Иша" android:textColor="#86EFAC"
            android:textSize="11sp" android:maxLines="1" android:singleLine="true" />
        <TextView android:id="@+id/w2_time_5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="--:--" android:textColor="#FFFFFF"
            android:textSize="11sp" android:textAlignment="viewEnd" android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
